# SatQuery AI - Environment Configuration Template
# Copy to .env and adjust if necessary.

# Primary Vision-Language Model
SATQUERY_USE_ADAPTED_VLM=1
SATQUERY_ADAPTER_PATH=models/adapters/experiments/qwen_rs_exp_a/best_checkpoint

# Primary Bi-Temporal Neural Change Detector
SATQUERY_TINYCD_CHECKPOINT=models/checkpoints/tinycd_finetuned.pth

# Shared VLM Runtime Toggle (1 = shared, 0 = separate instances)
SATQUERY_SHARED_VLM_RUNTIME=1
